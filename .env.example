# Copy to .env.local (SQLite dev) and fill in real values.
# Every var here is read once at boot by src/env.ts and validated with Zod —
# the process exits immediately with a clear error if something required is
# missing or malformed. Nothing else in the app touches process.env directly.

# --- Database ---------------------------------------------------------
# file:./data/app.db for SQLite, or postgres://user:pass@host:5432/db for Postgres.
DATABASE_URL=file:./data/app.db

# --- Sessions -----------------------------------------------------------
# Random string, 32+ chars. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- OIDC (Keycloak) ------------------------------------------------------
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak

# --- Media services (each is optional — omit both URL and API key to hide
# that service entirely from the app) ---------------------------------
SONARR_URL=
SONARR_API_KEY=

RADARR_URL=
RADARR_API_KEY=

LIDARR_URL=
LIDARR_API_KEY=

BAZARR_URL=
BAZARR_API_KEY=

PROWLARR_URL=
PROWLARR_API_KEY=

# --- Misc -----------------------------------------------------------------
LOG_LEVEL=info
PORT=3000
